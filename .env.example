# =============================================================
# Qoneqt Creator AI — Environment Variables
# Copy this file to .env and fill in actual values
# =============================================================

# ----- Application -----
APP_ENV=development           # development | production
SECRET_KEY=change-me-to-a-very-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:3000

# ----- MongoDB -----
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=qoneqt_creator

# ----- Redis & Celery -----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ----- AI Providers (leave blank to use demo mode) -----
# OpenAI
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_MODEL=tts-1

# Stability AI (optional image generation)
STABILITY_API_KEY=

# ElevenLabs (optional TTS)
ELEVENLABS_API_KEY=

# ----- Storage -----
STORAGE_BACKEND=local          # local | s3
LOCAL_STORAGE_PATH=./storage

# S3-compatible (only if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=qoneqt-creator
AWS_S3_REGION=us-east-1
AWS_S3_ENDPOINT_URL=          # leave blank for AWS, fill for MinIO etc.

# ----- FFmpeg -----
FFMPEG_PATH=ffmpeg            # path to ffmpeg binary

# ----- Qoneqt Integration -----
QONEQT_APP_URL=https://qoneqt.com
QONEQT_API_URL=               # official API URL if available; leave blank for manual workflow
QONEQT_API_KEY=               # leave blank if API not yet available

# ----- Rate Limiting -----
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# ----- Email / SMTP -----
BACKEND_EMAIL=
BACKEND_EMAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
